# Red Docker existente donde corre el servicio fastapi_app.
COBRANZA_DOCKER_NETWORK=sistema_cobranza_default

# Puerto publicado en el host. El contenedor escucha en el 80.
PANEL_PORT=3000

# Vacío: el panel usa el mismo host del navegador, puerto 8000.
# Ejemplo fijo: VITE_API_BASE_URL=http://72.62.105.25:8000
VITE_API_BASE_URL=
